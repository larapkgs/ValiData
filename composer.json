{
  "name": "larapkgs/vali-data",
  "description": "LaraPkgs Write Once Read Many times Data",
  "keywords": [],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "LaraPkgs",
      "email": "mail@larapkgs.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^13.0",
    "larapkgs/validation": "^1.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.30",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "LaraPkgs\\ValiData\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaraPkgs\\ValiData\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaraPkgs\\ValiData\\ValiDataServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "preflight": [
      "@format",
      "@analyse",
      "@test"
    ]
  }
}
